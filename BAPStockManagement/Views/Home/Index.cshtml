@model BAPStockManagement.ViewModels.Home.HomeDashboardViewModel

@{
    ViewData["Title"] = "หน้าแรก";
    var name = User.Identity?.Name?.Split('@')[0] ?? "ผู้ใช้";
    var maxCategoryStock = Math.Max(Model.CategoryStockChartItems.Select(i => i.QtyPieces).DefaultIfEmpty(0).Max(), 1);
    var maxDailyMovement = Math.Max(Model.DailyMovementChartItems.Select(i => Math.Max(i.InPieces, i.OutPieces)).DefaultIfEmpty(0).Max(), 1);
    var maxMonthlyMovement = Math.Max(Model.MonthlyMovementChartItems.Select(i => Math.Max(i.InPieces, i.OutPieces)).DefaultIfEmpty(0).Max(), 1);
    var distributionItems = Model.StockDistributionChartItems.OrderByDescending(i => i.QtyPieces).Take(5).ToList();
    var otherCategoryPieces = Model.StockDistributionChartItems.Skip(5).Sum(i => i.QtyPieces);
    if (otherCategoryPieces > 0)
    {
        distributionItems.Add(new BAPStockManagement.ViewModels.Home.CategoryStockChartItem { CategoryName = "อื่นๆ", QtyPieces = otherCategoryPieces });
    }

    var distributionTotal = distributionItems.Sum(i => i.QtyPieces);
    var distributionColors = new[] { "#2878D0", "#F2A93B", "#E94B62", "#8258D6", "#20A486", "#8492A6" };
    var distributionStops = new List<string>();
    var distributionOffset = 0d;
    if (distributionTotal > 0)
    {
        for (var index = 0; index < distributionItems.Count; index++)
        {
            var nextOffset = index == distributionItems.Count - 1
                ? 100
                : distributionOffset + (double)distributionItems[index].QtyPieces / distributionTotal * 100;
            var color = distributionColors[index % distributionColors.Length];
            distributionStops.Add(
                $"{color} {distributionOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}% {nextOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%");
            distributionOffset = nextOffset;
        }
    }

    var distributionDonutStyle = distributionStops.Count > 0
        ? $"background: conic-gradient({string.Join(", ", distributionStops)});"
        : string.Empty;
    const double trendChartLeft = 0;
    const double trendChartRight = 568;
    const double trendChartTop = 0;
    const double trendChartBottom = 210;
    var monthlyInPoints = new List<string>();
    var monthlyOutPoints = new List<string>();
    for (var index = 0; index < Model.MonthlyMovementChartItems.Count; index++)
    {
        var item = Model.MonthlyMovementChartItems[index];
        var x = trendChartLeft + index * (trendChartRight - trendChartLeft) / Math.Max(Model.MonthlyMovementChartItems.Count - 1, 1);
        var inY = trendChartBottom - item.InPieces * (trendChartBottom - trendChartTop) / maxMonthlyMovement;
        var outY = trendChartBottom - item.OutPieces * (trendChartBottom - trendChartTop) / maxMonthlyMovement;
        monthlyInPoints.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{inY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");
        monthlyOutPoints.Add($"{x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{outY.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}");
    }
}

<div id="dashboardSectionCarousel" class="carousel slide dashboard-section-carousel mb-4" data-bs-interval="false" aria-label="เนื้อหาแดชบอร์ด">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div class="greeting-bar">
                <h1>สวัสดี, @name 👋</h1>
                <p>ยินดีต้อนรับสู่ระบบจัดการสต็อกสินค้า BAP Stock</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-primary h-100">
                        <div>
                            <div class="stat-label">สินค้า active</div>
                            <div class="stat-value">@Model.ActiveProductCount.ToString("N0")</div>
                            <div class="stat-sub">@Model.ActiveVariantCount.ToString("N0") สี/รุ่น ใน @Model.ActiveCategoryCount.ToString("N0") หมวดหมู่</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-tags"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-success h-100">
                        <div>
                            <div class="stat-label">คงเหลือทั้งหมด</div>
                            <div class="stat-value">@Model.TotalPieces.ToString("N0")</div>
                            <div class="stat-sub">@Model.TotalCases.ToString("N0") กระสอบ/ลัง/เส้น</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-boxes"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-warning h-100">
                        <div>
                            <div class="stat-label">ใกล้หมด</div>
                            <div class="stat-value">@Model.LowStockProductCount.ToString("N0")</div>
                            <div class="stat-sub">สินค้าเหลือไม่เกิน 10 ชิ้น</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-danger h-100">
                        <div>
                            <div class="stat-label">หมดสต็อก</div>
                            <div class="stat-value">@Model.OutOfStockProductCount.ToString("N0")</div>
                            <div class="stat-sub">สินค้าไม่มีคงเหลือ</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-dash-circle"></i></div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card stat-info h-100">
                        <div>
                            <div class="stat-label">รับเข้าเดือนนี้</div>
                            <div class="stat-value">@Model.MonthInPieces.ToString("N0")</div>
                            <div class="stat-sub">ชิ้น</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-arrow-down-circle"></i></div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card stat-secondary h-100">
                        <div>
                            <div class="stat-label">จ่ายออกเดือนนี้</div>
                            <div class="stat-value">@Model.MonthOutPieces.ToString("N0")</div>
                            <div class="stat-sub">ชิ้น</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card stat-primary h-100">
                        <div>
                            <div class="stat-label">รายการเดือนนี้</div>
                            <div class="stat-value">@Model.MonthTransactionCount.ToString("N0")</div>
                            <div class="stat-sub">ล่าสุด @(Model.LastTransactionAt?.ToString("dd/MM/yyyy HH:mm") ?? "ยังไม่มีรายการ")</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                    </div>
                </div>

            </div>

            <div class="row g-3">
                <div class="col-xl-5">
                    <div class="chart-card h-100">
                        <div class="chart-card__header">
                            <div>
                                <h2>สต็อกตามหมวดหมู่</h2>
                                <p>Top 6 หมวดหมู่ที่มีจำนวนคงเหลือสูงสุด</p>
                            </div>
                            <i class="bi bi-bar-chart"></i>
                        </div>

                        @if (Model.CategoryStockChartItems.Count == 0)
                        {
                            <div class="chart-empty">ยังไม่มีข้อมูลสต็อกสำหรับแสดงกราฟ</div>
                        }
                        else
                        {
                            <div class="category-bar-list">
                                @foreach (var item in Model.CategoryStockChartItems)
                                {
                                    var percent = Math.Max((int)Math.Round(item.QtyPieces * 100.0 / maxCategoryStock), 3);
                                    <div class="category-bar-row">
                                        <div class="category-bar-meta">
                                            <span>@item.CategoryName</span>
                                            <strong>@item.QtyPieces.ToString("N0")</strong>
                                        </div>
                                        <div class="category-bar-track">
                                            <div class="category-bar-fill" style="width: @percent%;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-7">
                    <div class="chart-card h-100">
                        <div class="chart-card__header">
                            <div>
                                <h2>รับเข้า / จ่ายออก เดือนนี้</h2>
                                <p>เทียบจำนวนชิ้นรายวันในเดือนปัจจุบัน</p>
                            </div>
                            <div class="chart-legend">
                                <span><i class="legend-dot legend-dot--in"></i>รับเข้า</span>
                                <span><i class="legend-dot legend-dot--out"></i>จ่ายออก</span>
                            </div>
                        </div>

                        @if (Model.DailyMovementChartItems.Count == 0)
                        {
                            <div class="chart-empty">ยังไม่มีรายการเดือนนี้</div>
                        }
                        else
                        {
                            <div class="daily-chart">
                                @foreach (var item in Model.DailyMovementChartItems)
                                {
                                    var inHeight = Math.Max((int)Math.Round(item.InPieces * 100.0 / maxDailyMovement), item.InPieces > 0 ? 4 : 0);
                                    var outHeight = Math.Max((int)Math.Round(item.OutPieces * 100.0 / maxDailyMovement), item.OutPieces > 0 ? 4 : 0);
                                    <div class="daily-chart__day" title="วันที่ @item.Label: รับเข้า @item.InPieces.ToString("N0"), จ่ายออก @item.OutPieces.ToString("N0")">
                                        <div class="daily-chart__bars">
                                            <span class="daily-chart__bar daily-chart__bar--in" style="height: @inHeight%;"></span>
                                            <span class="daily-chart__bar daily-chart__bar--out" style="height: @outHeight%;"></span>
                                        </div>
                                        <div class="daily-chart__label">@item.Label</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

        <div class="carousel-item">
            <div class="greeting-bar">
                <h1>ภาพรวมสินค้าและสต็อก</h1>
                <p>สรุปจำนวนสินค้า สถานะคงเหลือ และความเคลื่อนไหวล่าสุด</p>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-primary h-100 dashboard-ai-summary">
                        <div>
                            <div class="stat-label">AI วิเคราะห์สินค้า</div>
                            <div class="stat-value">@Model.StockAnalysisCount.ToString("N0")</div>
                            <div class="stat-sub">รายการจากสต็อกที่ใช้งาน</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-robot"></i></div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-danger h-100 dashboard-ai-summary">
                        <div>
                            <div class="stat-label">เสี่ยงสูง / หมดสต็อก</div>
                            <div class="stat-value">@Model.CriticalPredictionCount.ToString("N0")</div>
                            <div class="stat-sub">คาดว่าจะหมดภายใน 3 วัน</div>
                            <a class="dashboard-ai-summary__link" href="#dashboard-ai-alerts">ตรวจสอบสินค้าที่มีความเสี่ยง</a>
                        </div>
                        <div class="stat-icon"><i class="bi bi-exclamation-octagon"></i></div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-warning h-100 dashboard-ai-summary">
                        <div>
                            <div class="stat-label">คาดว่าจะหมดใน 7 วัน</div>
                            <div class="stat-value">@Model.StockoutWithinSevenDaysCount.ToString("N0")</div>
                            <div class="stat-sub">อ้างอิงยอดจ่ายออกย้อนหลัง</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card stat-success h-100 dashboard-ai-summary">
                        <div>
                            <div class="stat-label">แนวโน้มจ่ายออกเพิ่มขึ้น</div>
                            <div class="stat-value">@Model.IncreasingSalesTrendCount.ToString("N0")</div>
                            <div class="stat-sub">เทียบ 30 วันล่าสุดกับช่วงก่อน</div>
                        </div>
                        <div class="stat-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    </div>
                </div>
            </div>
            <div class="dashboard-grid mb-4">
                @await Html.PartialAsync("_SmartRestockCard", Model)
                <div id="dashboard-ai-alerts" class="chart-card dashboard-insight-card dashboard-card">
                    <div class="chart-card__header">
                        <div class="dashboard-ai-card__heading">
                            <span class="dashboard-ai-card__icon dashboard-ai-card__icon--risk">
                                <i class="bi bi-robot" aria-hidden="true"></i>
                            </span>
                            <div>
                                <h2>AI คาดการณ์สินค้าเสี่ยงขาดสต็อก</h2>
                                <p>ใช้ยอดขายจากบิลที่เชื่อมกับสต็อกย้อนหลังสูงสุด 90 วัน</p>
                            </div>
                        </div>
                        <span class="dashboard-urgent-count">@Model.StockActionItems.Count.ToString("N0") รายการ</span>
                    </div>
                    <div class="dashboard-card__content dashboard-risk-content">
                        <div class="dashboard-stock-summary">
                            <div>
                                <span>สินค้าเสี่ยงสูง (≤3 วัน)</span>
                                <strong>@Model.StockActionItems.Count(item => item.RiskLevel == BAPStockManagement.ViewModels.Home.StockRiskLevel.Critical).ToString("N0")</strong>
                            </div>
                            <div>
                                <span>รายการต้องติดตาม</span>
                                <strong>@Model.StockActionItems.Count.ToString("N0")</strong>
                            </div>
                        </div>
                        @if (Model.StockActionItems.Count == 0)
                        {
                            <div class="chart-empty dashboard-risk-empty">ยังไม่มีสินค้าเข้าเกณฑ์เสี่ยงหรือใกล้หมดในขณะนี้</div>
                        }
                        else
                        {
                            <div class="dashboard-risk-list" tabindex="0" aria-label="รายการสินค้าเสี่ยงขาดสต็อก">
                                <div class="dashboard-urgent-list">
                                    @for (var index = 0; index < Model.StockActionItems.Count; index++)
                                    {
                                    var item = Model.StockActionItems[index];
                                    var riskLabel = item.RiskLevel switch
                                    {
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Critical => "วิกฤต",
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Warning => "เสี่ยงสูง",
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Normal => "เฝ้าระวัง",
                                        _ => "ข้อมูลไม่พอ"
                                    };
                                    var riskClass = item.RiskLevel switch
                                    {
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Critical => "dashboard-urgent-product__badge--critical",
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Warning => "dashboard-urgent-product__badge--warning",
                                        BAPStockManagement.ViewModels.Home.StockRiskLevel.Normal => "dashboard-urgent-product__badge--normal",
                                        _ => "dashboard-urgent-product__badge--unknown"
                                    };
                                    var trendLabel = item.SalesTrend switch
                                    {
                                        BAPStockManagement.ViewModels.Home.StockSalesTrend.Increasing => "เพิ่มขึ้น",
                                        BAPStockManagement.ViewModels.Home.StockSalesTrend.Decreasing => "ลดลง",
                                        BAPStockManagement.ViewModels.Home.StockSalesTrend.Stable => "ทรงตัว",
                                        _ => "ข้อมูลไม่พอ"
                                    };

                                        <div class="dashboard-urgent-product dashboard-ai-product"
                                             data-stock-page-item
                                             hidden="@(index >= 3 ? "hidden" : null)">
                                        <span class="dashboard-urgent-product__icon"><i class="bi bi-box-seam"></i></span>
                                        <div class="dashboard-urgent-product__name">
                                            <strong>@item.Sku</strong>
                                            <span>@item.ProductName</span>
                                        </div>
                                        <div class="dashboard-urgent-product__stock">
                                            <strong>คงเหลือ @item.CurrentStock.ToString("N0") @item.Unit</strong>
                                            <span>
                                                @if (item.AverageDailySales.HasValue)
                                                {
                                                    <text>เฉลี่ยขาย @item.AverageDailySales.Value.ToString("0.##") @item.Unit/วัน · แนวโน้ม@trendLabel</text>
                                                }
                                                else
                                                {
                                                    <text>ข้อมูลไม่เพียงพอสำหรับการคาดการณ์</text>
                                                }
                                            </span>
                                        </div>
                                        <span class="dashboard-urgent-product__badge @riskClass">@riskLabel</span>
                                        <div class="dashboard-ai-product__forecast">
                                            @if (item.DaysUntilStockout.HasValue)
                                            {
                                                <span>คาดว่าจะหมดใน @Math.Ceiling(item.DaysUntilStockout.Value).ToString("N0") วัน</span>
                                                @if (item.EstimatedStockoutDate.HasValue)
                                                {
                                                    <span>ประมาณ @item.EstimatedStockoutDate.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>ยังไม่สามารถระบุวันหมดสต็อกได้</span>
                                            }
                                            @if (item.IsLowStock)
                                            {
                                                <span>เข้าเกณฑ์ใกล้หมดเดิม (≤ @BAPStockManagement.Constants.StockThresholds.LowStockLimit @item.Unit)</span>
                                            }
                                        </div>
                                        <p class="dashboard-ai-product__recommendation" title="@item.Recommendation">@item.Recommendation</p>
                                        <div class="dashboard-ai-product__actions">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#stockPredictionModal"
                                                    data-sku="@item.Sku"
                                                    data-product="@item.ProductName"
                                                    data-stock="@item.CurrentStock"
                                                    data-unit="@item.Unit"
                                                    data-average="@(item.AverageDailySales?.ToString("0.##") ?? string.Empty)"
                                                    data-days="@(item.DaysUntilStockout?.ToString("0.##") ?? string.Empty)"
                                                    data-date="@(item.EstimatedStockoutDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                    data-risk="@riskLabel"
                                                    data-trend="@trendLabel"
                                                    data-window="@(item.AnalysisWindowDays?.ToString() ?? string.Empty)"
                                                    data-history-available="@item.AnalysisWindowDays.HasValue.ToString().ToLowerInvariant()"
                                                    data-recommendation="@item.Recommendation"
                                                    data-history="@System.Text.Json.JsonSerializer.Serialize(item.SalesHistory)">
                                                <i class="bi bi-clipboard-data" aria-hidden="true"></i> ดูรายละเอียดการวิเคราะห์
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#stockPredictionModal"
                                                    data-sku="@item.Sku"
                                                    data-product="@item.ProductName"
                                                    data-stock="@item.CurrentStock"
                                                    data-unit="@item.Unit"
                                                    data-average="@(item.AverageDailySales?.ToString("0.##") ?? string.Empty)"
                                                    data-days="@(item.DaysUntilStockout?.ToString("0.##") ?? string.Empty)"
                                                    data-date="@(item.EstimatedStockoutDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                                    data-risk="@riskLabel"
                                                    data-trend="@trendLabel"
                                                    data-window="@(item.AnalysisWindowDays?.ToString() ?? string.Empty)"
                                                    data-history-available="@item.AnalysisWindowDays.HasValue.ToString().ToLowerInvariant()"
                                                    data-recommendation="@item.Recommendation"
                                                    data-history="@System.Text.Json.JsonSerializer.Serialize(item.SalesHistory)">
                                                <i class="bi bi-graph-up" aria-hidden="true"></i> ดูกราฟแนวโน้ม
                                            </button>
                                        </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <p class="dashboard-ai-disclaimer">การคาดการณ์เป็นสถิติจากรายการจ่ายออกในระบบ ไม่ใช่โมเดล Machine Learning และไม่รวมหน่วยที่แปลงกันไม่ได้</p>
                    </div>
                    <div class="dashboard-card__footer dashboard-ai-card__footer">
                        @if (Model.StockActionItems.Count > 3)
                        {
                            <nav class="dashboard-ai-pagination" aria-label="หน้ารายการสินค้าเสี่ยง">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-stock-page-prev aria-label="รายการก่อนหน้า" disabled>
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </button>
                                <span data-stock-page-label>1–@Math.Min(3, Model.StockActionItems.Count) / @Model.StockActionItems.Count</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-stock-page-next aria-label="รายการถัดไป">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </button>
                            </nav>
                        }
                        @if (Model.StockActionItems.Count == 0)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>ไม่มีรายการเสี่ยง</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#stockActionsModal">
                                <i class="bi bi-list-ul" aria-hidden="true"></i> ดูสินค้าทั้งหมด (@Model.StockActionItems.Count.ToString("N0") รายการ)
                            </button>
                        }
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_TopUsedProductsCard", Model)

            <div class="row g-3">
                <div class="col-xl-7">
                    <div class="chart-card h-100">
                        <div class="chart-card__header">
                            <div>
                                <h2>แนวโน้มการเคลื่อนไหว</h2>
                                <p>จำนวนรับเข้าและจ่ายออกย้อนหลัง 6 เดือน (ชิ้น)</p>
                            </div>
                            <div class="chart-legend">
                                <span><i class="legend-dot legend-dot--trend-in"></i>รับเข้า</span>
                                <span><i class="legend-dot legend-dot--trend-out"></i>จ่ายออก</span>
                            </div>
                        </div>
                        <div class="dashboard-trend-chart">
                            <div class="dashboard-trend-chart__graph">
                                <div class="dashboard-trend-chart__scale" aria-hidden="true">
                                    @for (var tick = 0; tick <= 4; tick++)
                                    {
                                        var value = Math.Round(maxMonthlyMovement * (4 - tick) / 4d);
                                        <span>@value.ToString("N0")</span>
                                    }
                                </div>
                                <svg viewBox="0 0 568 210" preserveAspectRatio="none" role="img" aria-label="กราฟแนวโน้มรับเข้าและจ่ายออกย้อนหลัง 6 เดือน">
                                    <g class="dashboard-trend-chart__grid">
                                        @for (var tick = 0; tick <= 4; tick++)
                                        {
                                            var y = trendChartTop + (trendChartBottom - trendChartTop) * tick / 4;
                                            <line x1="@trendChartLeft" y1="@y" x2="@trendChartRight" y2="@y"></line>
                                        }
                                    </g>
                                    @if (monthlyInPoints.Count > 0)
                                    {
                                        <polyline class="dashboard-trend-chart__line dashboard-trend-chart__line--in" points="@string.Join(" ", monthlyInPoints)"></polyline>
                                        <polyline class="dashboard-trend-chart__line dashboard-trend-chart__line--out" points="@string.Join(" ", monthlyOutPoints)"></polyline>
                                    }
                                    @for (var index = 0; index < Model.MonthlyMovementChartItems.Count; index++)
                                    {
                                        var item = Model.MonthlyMovementChartItems[index];
                                        var x = trendChartLeft + index * (trendChartRight - trendChartLeft) / Math.Max(Model.MonthlyMovementChartItems.Count - 1, 1);
                                        var inY = trendChartBottom - item.InPieces * (trendChartBottom - trendChartTop) / maxMonthlyMovement;
                                        var outY = trendChartBottom - item.OutPieces * (trendChartBottom - trendChartTop) / maxMonthlyMovement;
                                        <circle class="dashboard-trend-chart__point dashboard-trend-chart__point--in" cx="@x" cy="@inY" r="3">
                                            <title>@item.Label รับเข้า @item.InPieces.ToString("N0") ชิ้น</title>
                                        </circle>
                                        <circle class="dashboard-trend-chart__point dashboard-trend-chart__point--out" cx="@x" cy="@outY" r="3">
                                            <title>@item.Label จ่ายออก @item.OutPieces.ToString("N0") ชิ้น</title>
                                        </circle>
                                    }
                                </svg>
                            </div>
                            <div class="dashboard-trend-chart__months">
                                @foreach (var item in Model.MonthlyMovementChartItems)
                                {
                                    <span>@item.Label</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-5">
                    <div class="chart-card h-100">
                        <div class="chart-card__header">
                            <div>
                                <h2>สัดส่วนสต็อกตามหมวดหมู่</h2>
                                <p>จำนวนคงเหลือแยกตามหมวดหมู่ (ชิ้น)</p>
                            </div>
                            <i class="bi bi-pie-chart"></i>
                        </div>
                        @if (distributionTotal == 0)
                        {
                            <div class="chart-empty">ยังไม่มีข้อมูลสต็อกสำหรับแสดงกราฟ</div>
                        }
                        else
                        {
                            <div class="stock-distribution">
                                <div class="stock-distribution__donut" style="@distributionDonutStyle" role="img" aria-label="สัดส่วนสต็อกตามหมวดหมู่">
                                    <div class="stock-distribution__center">
                                        <strong>@distributionTotal.ToString("N0")</strong>
                                        <span>ชิ้น</span>
                                    </div>
                                </div>
                                <ul class="stock-distribution__legend">
                                    @for (var index = 0; index < distributionItems.Count; index++)
                                    {
                                        var item = distributionItems[index];
                                        var color = distributionColors[index % distributionColors.Length];
                                        var percentage = item.QtyPieces * 100d / distributionTotal;
                                        <li>
                                            <span class="stock-distribution__name">
                                                <i style="--distribution-color: @color"></i>
                                                <span>@item.CategoryName</span>
                                            </span>
                                            <span class="stock-distribution__percentage">@percentage.ToString("0.#")%</span>
                                            <strong>@item.QtyPieces.ToString("N0")</strong>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-xl-6">
                    <div class="chart-card dashboard-bottom-card dashboard-simulation-card h-100">
                        <div class="chart-card__header">
                            <div class="dashboard-simulation-card__heading">
                                <span class="dashboard-simulation-card__icon"><i class="bi bi-sliders2"></i></span>
                                <div>
                                    <h2>What-if Simulation</h2>
                                    <p>ทดลองปรับจำนวนเติม แล้วดูสต็อกที่คาดว่าจะครอบคลุม</p>
                                </div>
                            </div>
                            <span class="dashboard-bottom-card__badge dashboard-bottom-card__badge--simulation">
                                <i class="bi bi-stars"></i> จำลอง
                            </span>
                        </div>

                        @if (Model.TopUsedProducts.Count == 0)
                        {
                            <div class="chart-empty">ยังไม่มีข้อมูลจ่ายออก 30 วันสำหรับจำลองสต็อก</div>
                        }
                        else
                        {
                            var initialProduct = Model.TopUsedProducts[0];
                            var maxScenarioQuantity = Math.Max(initialProduct.UsedQuantity, 1);
                            var initialScenarioQuantity = Math.Max((int)Math.Ceiling(maxScenarioQuantity / 2d), 1);
                            var initialScenarioStock = (long)initialProduct.CurrentStock + initialScenarioQuantity;
                            var initialCoverageDays = (long)Math.Floor(initialScenarioStock * 30d / initialProduct.UsedQuantity);

                            <div class="dashboard-simulation" data-dashboard-simulation>
                                <div class="dashboard-simulation__product">
                                    <span class="dashboard-simulation__product-icon"><i class="bi bi-box-seam"></i></span>
                                    <div class="dashboard-simulation__product-control">
                                        <label class="dashboard-simulation__label" for="dashboardSimulationProduct">เลือกสินค้า</label>
                                        <select id="dashboardSimulationProduct"
                                                class="form-select form-select-sm dashboard-simulation__select"
                                                data-simulation-product>
                                            @for (var index = 0; index < Model.TopUsedProducts.Count; index++)
                                            {
                                                var item = Model.TopUsedProducts[index];
                                                <option value="@index"
                                                        data-stock="@item.CurrentStock"
                                                        data-usage="@item.UsedQuantity"
                                                        data-unit="@item.Unit"
                                                        data-max="@Math.Max(item.UsedQuantity, 1)"
                                                        selected="@(index == 0 ? "selected" : null)">
                                                    @item.ProductName (@item.Sku)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="dashboard-simulation__range">
                                    <div class="dashboard-simulation__range-heading">
                                        <div>
                                            <label class="dashboard-simulation__label" for="dashboardSimulationQuantity">จำนวนที่จำลองเติม</label>
                                            <span class="dashboard-simulation__range-hint">ปรับได้สูงสุดเท่ายอดจ่ายออก 30 วัน</span>
                                        </div>
                                        <div class="dashboard-simulation__quantity-badge">
                                            <output data-simulation-quantity>@initialScenarioQuantity.ToString("N0")</output>
                                            <span data-simulation-unit>@initialProduct.Unit</span>
                                        </div>
                                    </div>
                                    <input id="dashboardSimulationQuantity"
                                           class="form-range"
                                           type="range"
                                           min="0"
                                           max="@maxScenarioQuantity"
                                           value="@initialScenarioQuantity"
                                           data-simulation-range />
                                    <div class="dashboard-simulation__range-labels">
                                        <span>0</span>
                                        <span data-simulation-max-label>@maxScenarioQuantity.ToString("N0") @initialProduct.Unit</span>
                                    </div>
                                </div>

                                <div class="dashboard-simulation__results" aria-live="polite">
                                    <div class="dashboard-simulation__metric">
                                        <span class="dashboard-simulation__metric-icon dashboard-simulation__metric-icon--stock">
                                            <i class="bi bi-boxes"></i>
                                        </span>
                                        <span class="dashboard-simulation__metric-label">คงเหลือปัจจุบัน</span>
                                        <strong>
                                            <span data-simulation-current>@initialProduct.CurrentStock.ToString("N0")</span>
                                            <small data-simulation-current-unit>@initialProduct.Unit</small>
                                        </strong>
                                    </div>
                                    <div class="dashboard-simulation__metric">
                                        <span class="dashboard-simulation__metric-icon dashboard-simulation__metric-icon--scenario">
                                            <i class="bi bi-plus-lg"></i>
                                        </span>
                                        <span class="dashboard-simulation__metric-label">หลังเติมจำลอง</span>
                                        <strong>
                                            <span data-simulation-stock>@initialScenarioStock.ToString("N0")</span>
                                            <small data-simulation-stock-unit>@initialProduct.Unit</small>
                                        </strong>
                                    </div>
                                    <div class="dashboard-simulation__metric dashboard-simulation__metric--coverage">
                                        <span class="dashboard-simulation__metric-icon dashboard-simulation__metric-icon--coverage">
                                            <i class="bi bi-clock-history"></i>
                                        </span>
                                        <span class="dashboard-simulation__metric-label">คาดการณ์ว่าพอใช้</span>
                                        <strong data-simulation-coverage>@initialCoverageDays.ToString("N0") วัน</strong>
                                    </div>
                                </div>
                                <p class="dashboard-simulation__note">
                                    <i class="bi bi-info-circle"></i>
                                    อิงยอดจ่ายออก 30 วันล่าสุด ไม่รวมราคาทุน และไม่ใช่การรับประกันการใช้จริง
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-6">
                    <div class="chart-card dashboard-bottom-card h-100">
                        <div class="chart-card__header">
                            <div>
                                <h2>Stock Insight วันนี้</h2>
                                <p>สรุปจากข้อมูลสต็อกและรายการจ่ายออกในระบบ</p>
                            </div>
                            <span class="dashboard-bottom-card__badge dashboard-bottom-card__badge--insight">ข้อมูลจริง</span>
                        </div>

                        <ul class="dashboard-insight-list">
                            @foreach (var insight in Model.StockInsights)
                            {
                                <li>
                                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                    <span>@insight</span>
                                </li>
                            }
                        </ul>

                        <div class="dashboard-insight-recommendation">
                            <i class="bi bi-lightbulb" aria-hidden="true"></i>
                            <p>@Model.StockInsightRecommendation</p>
                        </div>
                        <p class="dashboard-insight-disclaimer">เป็นสรุปตามกฎจากข้อมูลจริง ไม่ได้สร้างจากโมเดล AI</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="carousel-indicators dashboard-section-carousel__indicators">
        <button type="button" data-bs-target="#dashboardSectionCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="หน้า 1"></button>
        <button type="button" data-bs-target="#dashboardSectionCarousel" data-bs-slide-to="1" aria-label="หน้า 2"></button>
    </div>
</div>
<div class="modal fade" id="topUsedDetailsModal" tabindex="-1" aria-labelledby="topUsedDetailsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="topUsedDetailsModalTitle">รายละเอียด Top 5 สินค้าที่มีการใช้มากที่สุด</h2>
                    <p class="stock-prediction-modal__subtitle mb-0">ยอดจ่ายออกย้อนหลัง 30 วัน แบ่งตามช่วงละ 5 วัน</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                @if (Model.TopUsedProducts.Count == 0)
                {
                    <div class="chart-empty">ยังไม่มีรายการจ่ายออกในช่วง 30 วันที่ผ่านมา</div>
                }
                else
                {
                    <div class="dashboard-top-details">
                        @foreach (var item in Model.TopUsedProducts)
                        {
                            var maxBucket = Math.Max(item.TrendBuckets.DefaultIfEmpty(0).Max(), 1);
                            var changeValue = item.ChangePercent.GetValueOrDefault();
                            var changeLabel = !item.HasPreviousPeriodUsage
                                ? "ไม่มีข้อมูลช่วงก่อนหน้า"
                                : changeValue > 0
                                    ? $"เพิ่มขึ้น {changeValue:N0}%"
                                    : changeValue < 0
                                        ? $"ลดลง {Math.Abs(changeValue):N0}%"
                                        : "ทรงตัว";

                            <article class="dashboard-top-details__item">
                                <div class="dashboard-top-details__header">
                                    <div>
                                        <strong>@item.Sku</strong>
                                        <span>@item.ProductName</span>
                                    </div>
                                    <span>@changeLabel</span>
                                </div>
                                <div class="dashboard-top-details__metrics">
                                    <span>จ่ายออก 30 วัน <strong>@item.UsedQuantity.ToString("N0") @item.Unit</strong></span>
                                    <span>คงเหลือ <strong>@item.CurrentStock.ToString("N0") @item.Unit</strong></span>
                                </div>
                                <div class="dashboard-top-details__buckets">
                                    @for (var index = 0; index < item.TrendBuckets.Count; index++)
                                    {
                                        var quantity = item.TrendBuckets[index];
                                        var height = Math.Max(quantity * 100d / maxBucket, quantity > 0 ? 8 : 0);
                                        <div class="dashboard-top-details__bucket">
                                            <div class="dashboard-top-details__bar" title="@quantity.ToString("N0") @item.Unit">
                                                <span style="height: @height.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                            </div>
                                            <strong>@quantity.ToString("N0")</strong>
                                            <small>วันที่ @(index * 5 + 1)-@Math.Min((index + 1) * 5, 30)</small>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="stockActionsModal" tabindex="-1" aria-labelledby="stockActionsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="stockActionsModalTitle">สินค้าทั้งหมดที่ต้องติดตาม</h2>
                    <p class="stock-prediction-modal__subtitle mb-0">@Model.StockActionItems.Count.ToString("N0") รายการ จากข้อมูลสต็อกและยอดขายจริง</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                @if (Model.StockActionItems.Count == 0)
                {
                    <div class="chart-empty">ยังไม่มีสินค้าเข้าเกณฑ์เสี่ยงหรือใกล้หมดในขณะนี้</div>
                }
                else
                {
                    <div class="dashboard-ai-modal-list">
                        @foreach (var item in Model.StockActionItems)
                        {
                            var riskLabel = item.RiskLevel switch
                            {
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Critical => "วิกฤต",
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Warning => "เสี่ยง",
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Normal => "ปกติ",
                                _ => "ข้อมูลไม่พอ"
                            };
                            var riskClass = item.RiskLevel switch
                            {
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Critical => "dashboard-urgent-product__badge--critical",
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Warning => "dashboard-urgent-product__badge--warning",
                                BAPStockManagement.ViewModels.Home.StockRiskLevel.Normal => "dashboard-urgent-product__badge--normal",
                                _ => "dashboard-urgent-product__badge--unknown"
                            };
                            var trendLabel = item.SalesTrend switch
                            {
                                BAPStockManagement.ViewModels.Home.StockSalesTrend.Increasing => "เพิ่มขึ้น",
                                BAPStockManagement.ViewModels.Home.StockSalesTrend.Decreasing => "ลดลง",
                                BAPStockManagement.ViewModels.Home.StockSalesTrend.Stable => "ทรงตัว",
                                _ => "ข้อมูลไม่พอ"
                            };

                            <article class="dashboard-ai-modal-item">
                                <div class="dashboard-ai-modal-item__header">
                                    <div class="dashboard-ai-modal-item__identity">
                                        <strong>@item.Sku</strong>
                                        <span>@item.ProductName</span>
                                    </div>
                                    <span class="dashboard-urgent-product__badge @riskClass">@riskLabel</span>
                                </div>
                                <div class="dashboard-ai-modal-item__facts">
                                    <span>คงเหลือ <strong>@item.CurrentStock.ToString("N0") @item.Unit</strong></span>
                                    @if (item.AverageDailySales.HasValue)
                                    {
                                        <span>เฉลี่ย <strong>@item.AverageDailySales.Value.ToString("0.##") @item.Unit/วัน</strong></span>
                                        <span>แนวโน้ม <strong>@trendLabel</strong></span>
                                    }
                                    @if (item.DaysUntilStockout.HasValue)
                                    {
                                        <span>คาดว่าจะหมดใน <strong>@Math.Ceiling(item.DaysUntilStockout.Value).ToString("N0") วัน</strong></span>
                                    }
                                    @if (item.EstimatedStockoutDate.HasValue)
                                    {
                                        <span>วันที่คาดการณ์ <strong>@item.EstimatedStockoutDate.Value.ToString("dd/MM/yyyy")</strong></span>
                                    }
                                </div>
                                <p class="dashboard-ai-modal-item__recommendation">@item.Recommendation</p>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        data-stock-analysis
                                        data-sku="@item.Sku"
                                        data-product="@item.ProductName"
                                        data-stock="@item.CurrentStock"
                                        data-unit="@item.Unit"
                                        data-average="@(item.AverageDailySales?.ToString("0.##") ?? string.Empty)"
                                        data-days="@(item.DaysUntilStockout?.ToString("0.##") ?? string.Empty)"
                                        data-date="@(item.EstimatedStockoutDate?.ToString("dd/MM/yyyy") ?? string.Empty)"
                                        data-risk="@riskLabel"
                                        data-trend="@trendLabel"
                                        data-window="@(item.AnalysisWindowDays?.ToString() ?? string.Empty)"
                                        data-history-available="@item.AnalysisWindowDays.HasValue.ToString().ToLowerInvariant()"
                                        data-recommendation="@item.Recommendation"
                                        data-history="@System.Text.Json.JsonSerializer.Serialize(item.SalesHistory)">
                                    <i class="bi bi-clipboard-data" aria-hidden="true"></i> ดูรายละเอียดการวิเคราะห์
                                </button>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="smartRestockInfoModal" tabindex="-1" aria-labelledby="smartRestockInfoModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="smartRestockInfoModalTitle">ยังสร้างรายการสั่งซื้อไม่ได้</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <p>ระบบปัจจุบันยังไม่มีโมดูลใบสั่งซื้อหรือข้อมูลจัดซื้อที่จำเป็น จึงยังคำนวณจำนวนซื้อและสร้างรายการสั่งซื้อจริงไม่ได้</p>
                <p class="mb-0">ต้องมี Lead Time, Safety Stock, Target Coverage, จำนวนรับเข้าที่ยังมาไม่ถึง, จำนวนที่จอง, MOQ และหน่วยบรรจุ ก่อนเปิดใช้การแนะนำจำนวนซื้อได้</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">รับทราบ</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="stockPredictionModal" tabindex="-1" aria-labelledby="stockPredictionModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5" id="stockPredictionModalTitle">AI Stock Analysis</h2>
                    <p class="stock-prediction-modal__subtitle mb-0" id="stockPredictionModalSubtitle"></p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary me-2" id="returnToStockActionsButton" hidden>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> กลับไปรายการทั้งหมด
                </button>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
            </div>
            <div class="modal-body">
                <div class="stock-prediction-modal__metrics">
                    <div><span>คงเหลือ</span><strong id="predictionModalStock">-</strong></div>
                    <div><span>เฉลี่ยจ่ายออก/วัน</span><strong id="predictionModalAverage">-</strong></div>
                    <div><span>คาดว่าจะหมด</span><strong id="predictionModalDays">-</strong></div>
                    <div><span>วันที่คาดการณ์</span><strong id="predictionModalDate">-</strong></div>
                    <div><span>ความเสี่ยง</span><strong id="predictionModalRisk">-</strong></div>
                    <div><span>แนวโน้ม</span><strong id="predictionModalTrend">-</strong></div>
                </div>
                <div class="stock-prediction-modal__section">
                    <h3>ยอดขายย้อนหลัง 30 วัน</h3>
                    <p class="stock-prediction-modal__empty" id="predictionHistoryEmpty" hidden>ไม่มีข้อมูลยอดขายย้อนหลังเพียงพอสำหรับแสดงกราฟ</p>
                    <svg id="predictionHistoryChart" class="stock-prediction-chart" viewBox="0 0 600 190" role="img" aria-label="กราฟยอดขายย้อนหลัง 30 วัน"></svg>
                </div>
                <div class="stock-prediction-modal__section">
                    <h3>แนวโน้มสต็อกตามอัตราจ่ายออกเฉลี่ย</h3>
                    <p class="stock-prediction-modal__empty" id="predictionForecastEmpty" hidden>ข้อมูลไม่เพียงพอสำหรับการคาดการณ์แนวโน้มสต็อก</p>
                    <svg id="predictionForecastChart" class="stock-prediction-chart" viewBox="0 0 600 190" role="img" aria-label="กราฟคาดการณ์สต็อก"></svg>
                    <p class="stock-prediction-modal__reason" id="predictionModalReason"></p>
                    <div class="stock-prediction-modal__recommendation" id="predictionModalRecommendation"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<button class="dashboard-section-carousel__control dashboard-section-carousel__control--fixed" type="button" data-bs-target="#dashboardSectionCarousel" data-bs-slide="next" aria-label="ไปหน้าถัดไป" title="ไปหน้าถัดไป">
    <i class="bi bi-arrow-right" aria-hidden="true"></i>
</button>

@section Scripts {
    <script>
        (function () {
            var stockPageItems = document.querySelectorAll('[data-stock-page-item]');
            var stockPageLabel = document.querySelector('[data-stock-page-label]');
            var stockPagePrevious = document.querySelector('[data-stock-page-prev]');
            var stockPageNext = document.querySelector('[data-stock-page-next]');
            var stockPageScroller = document.querySelector('.dashboard-risk-list');
            var stockPageSize = 3;
            var stockPageCount = Math.ceil(stockPageItems.length / stockPageSize);
            var currentStockPage = 0;

            if (stockPageItems.length > 0 && stockPageLabel && stockPagePrevious && stockPageNext) {
                function renderStockPage() {
                    var start = currentStockPage * stockPageSize;
                    var end = Math.min(start + stockPageSize, stockPageItems.length);

                    stockPageItems.forEach(function (item, index) {
                        item.hidden = index < start || index >= end;
                    });
                    if (stockPageScroller) stockPageScroller.scrollTop = 0;
                    stockPageLabel.textContent =
                        (start + 1).toLocaleString('th-TH') + '–' + end.toLocaleString('th-TH') +
                        ' / ' + stockPageItems.length.toLocaleString('th-TH');
                    stockPagePrevious.disabled = currentStockPage === 0;
                    stockPageNext.disabled = currentStockPage >= stockPageCount - 1;
                }

                stockPagePrevious.addEventListener('click', function () {
                    if (currentStockPage > 0) {
                        currentStockPage--;
                        renderStockPage();
                    }
                });
                stockPageNext.addEventListener('click', function () {
                    if (currentStockPage < stockPageCount - 1) {
                        currentStockPage++;
                        renderStockPage();
                    }
                });
            }

            var modal = document.getElementById('stockPredictionModal');
            if (!modal) return;

            var stockActionsModalElement = document.getElementById('stockActionsModal');
            var stockActionsModal = bootstrap.Modal.getOrCreateInstance(stockActionsModalElement);
            var predictionModal = bootstrap.Modal.getOrCreateInstance(modal);
            var returnToStockActionsButton = document.getElementById('returnToStockActionsButton');
            var shouldReturnToStockActions = false;

            stockActionsModalElement.addEventListener('click', function (event) {
                var trigger = event.target.closest('[data-stock-analysis]');
                if (!trigger) return;

                shouldReturnToStockActions = true;
                stockActionsModalElement.addEventListener('hidden.bs.modal', function openAnalysis() {
                    stockActionsModalElement.removeEventListener('hidden.bs.modal', openAnalysis);
                    predictionModal.show(trigger);
                });
                stockActionsModal.hide();
            });

            modal.addEventListener('show.bs.modal', function () {
                returnToStockActionsButton.hidden = !shouldReturnToStockActions;
            });
            modal.addEventListener('hidden.bs.modal', function () {
                returnToStockActionsButton.hidden = true;
                if (shouldReturnToStockActions) {
                    shouldReturnToStockActions = false;
                    stockActionsModal.show();
                }
            });
            returnToStockActionsButton.addEventListener('click', function () {
                predictionModal.hide();
            });

            var historyChart = document.getElementById('predictionHistoryChart');
            var forecastChart = document.getElementById('predictionForecastChart');
            var historyEmpty = document.getElementById('predictionHistoryEmpty');
            var forecastEmpty = document.getElementById('predictionForecastEmpty');
            var svgNamespace = 'http://www.w3.org/2000/svg';

            function createSvgElement(name, attributes, text) {
                var element = document.createElementNS(svgNamespace, name);
                Object.keys(attributes || {}).forEach(function (key) {
                    element.setAttribute(key, attributes[key]);
                });
                if (text !== undefined) element.textContent = text;
                return element;
            }

            function getPointQuantity(point) {
                return Number(point.quantity !== undefined ? point.quantity : point.Quantity) || 0;
            }

            function renderHistory(history) {
                historyChart.replaceChildren();
                var maxQuantity = Math.max.apply(null, [1].concat(history.map(getPointQuantity)));
                historyChart.appendChild(createSvgElement('line', { x1: 24, y1: 151, x2: 588, y2: 151, class: 'stock-prediction-chart__axis' }));

                history.forEach(function (point, index) {
                    var quantity = getPointQuantity(point);
                    var x = 28 + index * 18.5;
                    var height = quantity * 116 / maxQuantity;
                    historyChart.appendChild(createSvgElement('rect', {
                        x: x,
                        y: 150 - height,
                        width: 11,
                        height: height,
                        rx: 2,
                        class: 'stock-prediction-chart__bar'
                    }));

                    if (index % 5 === 0 || index === history.length - 1) {
                        historyChart.appendChild(createSvgElement('text', {
                            x: x + 5.5,
                            y: 174,
                            'text-anchor': 'middle',
                            class: 'stock-prediction-chart__label'
                        }, point.label !== undefined ? point.label : point.Label));
                    }
                });
            }

            function renderForecast(stock, average, days) {
                forecastChart.replaceChildren();
                var maxStock = Math.max(stock, 1);
                var horizon = Math.min(days, 30);
                var projectedStock = Math.max(stock - average * horizon, 0);
                var startY = 150 - stock * 116 / maxStock;
                var endY = 150 - projectedStock * 116 / maxStock;

                forecastChart.appendChild(createSvgElement('line', { x1: 30, y1: 151, x2: 580, y2: 151, class: 'stock-prediction-chart__axis' }));
                forecastChart.appendChild(createSvgElement('line', {
                    x1: 34,
                    y1: startY,
                    x2: 574,
                    y2: endY,
                    class: 'stock-prediction-chart__forecast'
                }));
                forecastChart.appendChild(createSvgElement('circle', { cx: 34, cy: startY, r: 4, class: 'stock-prediction-chart__point' }));
                forecastChart.appendChild(createSvgElement('circle', { cx: 574, cy: endY, r: 4, class: 'stock-prediction-chart__point' }));
                forecastChart.appendChild(createSvgElement('text', { x: 34, y: 174, class: 'stock-prediction-chart__label' }, 'วันนี้ · ' + stock));
                forecastChart.appendChild(createSvgElement('text', {
                    x: 574,
                    y: 174,
                    'text-anchor': 'end',
                    class: 'stock-prediction-chart__label'
                }, 'อีก ' + horizon.toFixed(0) + ' วัน · ' + projectedStock.toFixed(1)));
            }

            modal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                if (!trigger) return;

                var historyAvailable = trigger.dataset.historyAvailable === 'true';
                var average = Number(trigger.dataset.average);
                var days = Number(trigger.dataset.days);
                var stock = Number(trigger.dataset.stock) || 0;
                var unit = trigger.dataset.unit || '';
                var history = JSON.parse(trigger.dataset.history || '[]');

                document.getElementById('stockPredictionModalTitle').textContent = trigger.dataset.sku || '';
                document.getElementById('stockPredictionModalSubtitle').textContent = trigger.dataset.product || '';
                document.getElementById('predictionModalStock').textContent = stock.toLocaleString('th-TH') + ' ' + unit;
                document.getElementById('predictionModalAverage').textContent = historyAvailable
                    ? average.toLocaleString('th-TH', { maximumFractionDigits: 2 }) + ' ' + unit + '/วัน'
                    : 'ข้อมูลไม่เพียงพอ';
                document.getElementById('predictionModalDays').textContent = trigger.dataset.days !== '' && Number.isFinite(days)
                    ? Math.ceil(days).toLocaleString('th-TH') + ' วัน'
                    : 'ยังประเมินไม่ได้';
                document.getElementById('predictionModalDate').textContent = trigger.dataset.date || 'ยังประเมินไม่ได้';
                document.getElementById('predictionModalRisk').textContent = trigger.dataset.risk || '';
                document.getElementById('predictionModalTrend').textContent = trigger.dataset.trend || '';
                historyChart.hidden = !historyAvailable;
                historyEmpty.hidden = historyAvailable;
                forecastChart.hidden = !historyAvailable;
                forecastEmpty.hidden = historyAvailable;

                if (historyAvailable) {
                    renderHistory(history);
                    renderForecast(stock, average, days);
                }

                var reason = historyAvailable
                    ? 'คำนวณจากยอดขายในบิลที่เชื่อมกับสต็อกย้อนหลัง ' + (trigger.dataset.window || '90') +
                        ' วัน เปรียบเทียบแนวโน้มกับช่วง 30 วันก่อนหน้า ระดับความเสี่ยง: ' + (trigger.dataset.risk || '') + '.'
                    : 'ไม่พบประวัติยอดขายในบิลที่เชื่อมกับสต็อกในช่วง 90 วันที่ใช้วิเคราะห์ จึงไม่แสดงค่าคาดการณ์ที่ไม่มีข้อมูลรองรับ.';
                document.getElementById('predictionModalReason').textContent = reason;
                document.getElementById('predictionModalRecommendation').textContent = trigger.dataset.recommendation || '';
            });
        })();
    </script>
    <script>
        (function () {
            var simulation = document.querySelector('[data-dashboard-simulation]');
            if (!simulation) return;

            var productSelect = simulation.querySelector('[data-simulation-product]');
            var quantityRange = simulation.querySelector('[data-simulation-range]');
            var quantityOutput = simulation.querySelector('[data-simulation-quantity]');
            var unitOutput = simulation.querySelector('[data-simulation-unit]');
            var currentStockOutput = simulation.querySelector('[data-simulation-current]');
            var currentStockUnitOutput = simulation.querySelector('[data-simulation-current-unit]');
            var simulatedStockOutput = simulation.querySelector('[data-simulation-stock]');
            var simulatedStockUnitOutput = simulation.querySelector('[data-simulation-stock-unit]');
            var coverageOutput = simulation.querySelector('[data-simulation-coverage]');
            var rangeMaxLabel = simulation.querySelector('[data-simulation-max-label]');

            function formatQuantity(value) {
                return Number(value).toLocaleString('th-TH');
            }

            function updateSimulation(resetQuantity) {
                var selectedProduct = productSelect.options[productSelect.selectedIndex];
                var currentStock = Number(selectedProduct.dataset.stock) || 0;
                var recentUsage = Number(selectedProduct.dataset.usage) || 0;
                var unit = selectedProduct.dataset.unit || '';
                var maxQuantity = Math.max(Number(selectedProduct.dataset.max) || 0, 1);

                quantityRange.max = String(maxQuantity);
                if (resetQuantity) {
                    quantityRange.value = String(Math.max(Math.ceil(maxQuantity / 2), 1));
                } else if (Number(quantityRange.value) > maxQuantity) {
                    quantityRange.value = String(maxQuantity);
                }

                var additionalQuantity = Number(quantityRange.value) || 0;
                var simulatedStock = currentStock + additionalQuantity;
                var rangeProgress = maxQuantity > 0 ? additionalQuantity * 100 / maxQuantity : 0;
                var coverageDays = recentUsage > 0
                    ? Math.floor(simulatedStock * 30 / recentUsage)
                    : 0;

                quantityOutput.textContent = formatQuantity(additionalQuantity);
                unitOutput.textContent = unit;
                currentStockOutput.textContent = formatQuantity(currentStock);
                currentStockUnitOutput.textContent = unit;
                simulatedStockOutput.textContent = formatQuantity(simulatedStock);
                simulatedStockUnitOutput.textContent = unit;
                coverageOutput.textContent = formatQuantity(coverageDays) + ' วัน';
                rangeMaxLabel.textContent = formatQuantity(maxQuantity) + ' ' + unit;
                quantityRange.style.setProperty('--range-progress', rangeProgress + '%');
            }

            productSelect.addEventListener('change', function () {
                updateSimulation(true);
            });
            quantityRange.addEventListener('input', function () {
                updateSimulation(false);
            });
        })();
    </script>
}
