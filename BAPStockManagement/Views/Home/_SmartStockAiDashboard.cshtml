@model BAPStockManagement.ViewModels.Home.SmartStockDashboardViewModel
@using BAPStockManagement.ViewModels.Home
@using System.Text.Json
@{
    var orders = Model.Analyses.Where(item => item.Purchase.SuggestedQuantity > 0)
        .OrderByDescending(item => item.Purchase.Priority == "Urgent")
        .ThenByDescending(item => item.Purchase.SuggestedQuantity).ToArray();
    var panels = new[]
    {
        (Key: "risk", Title: "AI วิเคราะห์ความเสี่ยงสินค้าขาดสต็อก", Items: Model.Analyses, Buying: false,
            Empty: "ยังไม่มีสินค้าที่ประเมินความเสี่ยงได้"),
        (Key: "purchase", Title: "AI แนะนำการสั่งซื้อ", Items: (IReadOnlyList<SmartStockAnalysis>)orders, Buying: true,
            Empty: "ยังไม่มีคำแนะนำให้สั่งเพิ่ม")
    };
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var weekText = $"{Model.ForecastWeek:dd/MM} – {Model.Period.WeekEnd:dd/MM/yyyy}";
    var forecastAction = $"{Url.Action("Index", "Home")}#smartStockHeading";
    var actualText = Model.ActualsFrom is DateOnly from && Model.ActualsThrough is DateOnly through
        ? $"{from:dd/MM} – {through.AddDays(6):dd/MM/yyyy}"
        : "ยังไม่มีข้อมูล";
    var lastActualText = Model.ActualsThrough is DateOnly lastWeek
        ? $"ยอดจริงสัปดาห์ {lastWeek:dd/MM} – {lastWeek.AddDays(6):dd/MM/yyyy}"
        : "ยังไม่มียอดจริง";
    var stats = new[]
    {
        (Label: "สินค้าที่วิเคราะห์", Value: $"{Model.Analyses.Count:N0} / {Model.ProductCount:N0}", Icon: "bi-box-seam", Tone: "primary"),
        (Label: "ความเสี่ยงสูง", Value: Model.Analyses.Count(item => item.Risk.RiskLevel == "High").ToString("N0"), Icon: "bi-exclamation-octagon", Tone: "danger"),
        (Label: "ความเสี่ยงปานกลาง", Value: Model.Analyses.Count(item => item.Risk.RiskLevel == "Medium").ToString("N0"), Icon: "bi-exclamation-triangle", Tone: "warning"),
        (Label: "ความเสี่ยงต่ำ", Value: Model.Analyses.Count(item => item.Risk.RiskLevel == "Low").ToString("N0"), Icon: "bi-check-circle", Tone: "success")
    };
}

<section class="smart-stock-live" data-smart-stock-dashboard aria-labelledby="smartStockHeading">
    <header class="smart-stock-live__heading mb-3">
        <div class="section-heading">
            <h2 id="smartStockHeading">BAPSM+ Smart Stock AI</h2>
            <p class="mb-0">พยากรณ์ยอดขายรายสัปดาห์จากยอดขายและสต็อกในระบบ</p>
        </div>
        <form method="get" action="@forecastAction" class="smart-stock-live__period" data-smart-stock-period>
            <label for="smartStockForecastDate" class="form-label mb-1">วันที่ต้องการพยากรณ์</label>
            <div class="smart-stock-live__period-controls">
                <input id="smartStockForecastDate" name="forecastDate" type="date" class="form-control"
                       value="@Model.Period.SelectedDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       min="@Model.Period.EarliestWeek?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       max="@Model.Period.LatestSelectableDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       aria-describedby="smartStockWeekRange" required />
                <button type="submit" class="btn btn-primary">ดูผลพยากรณ์</button>
            </div>
            <p id="smartStockWeekRange" class="mb-0">สัปดาห์จันทร์–อาทิตย์ @weekText</p>
        </form>
    </header>

    <div class="row g-3 mb-4">
        @foreach (var stat in stats)
        {
            <div class="col-6 col-xl-3">
                <div class="stat-card stat-@stat.Tone h-100">
                    <div><div class="stat-label">@stat.Label</div><div class="stat-value">@stat.Value</div></div>
                    <div class="stat-icon"><i class="bi @stat.Icon" aria-hidden="true"></i></div>
                </div>
            </div>
        }
    </div>

    <section class="chart-card smart-stock-chart-card mb-4">
        <div class="chart-card__header">
            <div>
                <h2>ยอดขายจริงและยอดขายคาดการณ์</h2>
                <p>ยอดขายรายสัปดาห์ ไม่รวมรายการเกิน 100 หน่วย</p>
            </div>
            <div class="chart-legend">
                <span><i class="legend-dot smart-stock-legend-actual"></i>ยอดขายจริง</span>
                <span><i class="smart-stock-live__legend-dash" aria-hidden="true"></i>ยอดที่โมเดลคาดสำหรับ 1 สัปดาห์</span>
            </div>
        </div>
        <dl class="smart-stock-live__totals" aria-live="polite">
            <div><dt>ยอดขายจริง</dt><dd><span data-chart-actual>@(Model.ActualSales?.ToString("N0") ?? "—")</span> <small>@actualText</small></dd></div>
            <div><dt>จำนวนที่คาดว่าจะขายได้ @weekText</dt><dd data-chart-forecast>@(Model.ForecastSales?.ToString("N0") ?? "—")</dd></div>
        </dl>
        @if (Model.ForecastStatus is string status)
        {
            <div class="smart-stock-live__notice" role="status">
                @status
                @if (Model.SuggestedForecastDate is DateOnly suggested)
                {
                    <a asp-controller="Home" asp-action="Index"
                       asp-route-forecastDate="@suggested.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       asp-fragment="smartStockHeading">ดูสัปดาห์ @suggested.ToString("dd/MM/yyyy") ถัดจากยอดขายล่าสุด</a>
                }
            </div>
        }
        <div class="smart-stock-filter" aria-label="กรองตามกลุ่มสินค้า">
            <button type="button" class="btn btn-sm btn-primary" data-smart-stock-filter="all" aria-pressed="true">ทั้งหมด</button>
            @foreach (var segment in Model.Segments)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-smart-stock-filter="@segment.Segment" aria-pressed="false">@segment.Label</button>
            }
        </div>
        <div class="smart-stock-forecast-chart" data-smart-stock-chart>
            <p class="smart-stock-live__notice" data-chart-empty hidden>ยังไม่มีข้อมูลรายสัปดาห์สำหรับกลุ่มนี้</p>
            <svg viewBox="0 0 700 240" role="img" aria-label="กราฟยอดขายจริงและยอดพยากรณ์รายสัปดาห์"></svg>
        </div>
        <p class="smart-stock-live__chart-note" data-chart-forecast-note hidden>
            เส้นประเชื่อมยอดขายจริงล่าสุดกับจำนวนที่โมเดลคาดว่าจะขายได้ในสัปดาห์ที่เลือก
        </p>
    </section>

    @if (Model.StockAsOf is DateOnly stockAsOf && Model.Analyses.Count > 0)
    {
        <p class="smart-stock-live__notice mb-2">การวิเคราะห์ย้อนหลังใช้ยอดสต็อกจากประวัติ ณ สิ้นวันที่ @stockAsOf.ToString("dd/MM/yyyy")</p>
    }
    <div class="row g-3 mb-4">
        @foreach (var panel in panels)
        {
            var modalId = $"smartStock{panel.Key}List";
            <div class="col-xl-6">
                <section class="chart-card h-100">
                    <div class="chart-card__header">
                        <h2>@panel.Title</h2>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#@modalId">
                            <i class="bi bi-list-ul me-1" aria-hidden="true"></i>ดูรายการทั้งหมด (@panel.Items.Count)
                        </button>
                    </div>
                    <div class="smart-stock-live__preview">
                        @await Html.PartialAsync("~/Views/Home/_SmartStockAnalysisList.cshtml",
                            new SmartStockAnalysisListViewModel(panel.Items.Take(4).ToArray(), panel.Buying, panel.Empty))
                    </div>
                </section>
            </div>
        }
    </div>
    @if (Model.ForecastSales != null && Model.Analyses.Count < Model.ProductCount)
    {
        <p class="smart-stock-live__notice mb-3">ประเมินเฉพาะสินค้าที่มีกลุ่มโมเดลและประวัติขายใน 12 สัปดาห์ล่าสุด</p>
    }

    <section class="chart-card">
        <div class="chart-card__header">
            <div>
                <h2>ยอดขายตามกลุ่มสินค้า</h2>
                <p>@lastActualText · คาดการณ์สัปดาห์ @weekText</p>
            </div>
        </div>
        <div class="row g-2 smart-stock-segments">
            @foreach (var segment in Model.Segments)
            {
                <div class="col-sm-6 col-xl-4">
                    <div class="smart-stock-segment-card">
                        <strong>@segment.Label</strong>
                        <span>ยอดจริง @(segment.LastWeekActual?.ToString("N0") ?? "—")</span>
                        <span>ยอดคาดการณ์ @(segment.Forecast?.ToString("N0") ?? "—")</span>
                        @if (segment.Model != null) { <small>@segment.Model</small> }
                    </div>
                </div>
            }
        </div>
    </section>

    @foreach (var panel in panels)
    {
        var modalId = $"smartStock{panel.Key}List";
        var titleId = modalId + "Title";
        <div class="modal fade smart-stock-live__modal" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-hidden="true" data-smart-stock-list>
            <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
                <div class="modal-content">
                    <div class="modal-header smart-stock-live__modal-header">
                        <div><h2 class="modal-title fs-5" id="@titleId">@panel.Title</h2><p class="mb-0">สัปดาห์ @weekText</p></div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
                    </div>
                    <div class="modal-body">
                        @if (panel.Items.Count > 0)
                        {
                            <div class="smart-stock-live__filters">
                                <input type="search" class="form-control" placeholder="ค้นหาชื่อสินค้า หรือ SKU"
                                       aria-label="ค้นหาชื่อสินค้า หรือ SKU" data-list-search />
                                <select class="form-select" data-list-risk aria-label="ระดับความเสี่ยง">
                                    <option value="">ทุกระดับความเสี่ยง</option>
                                    <option value="High">สูง</option>
                                    <option value="Medium">ปานกลาง</option>
                                    <option value="Low">ต่ำ</option>
                                </select>
                            </div>
                            <p class="smart-stock-live__count" data-list-count aria-live="polite">@panel.Items.Count รายการ</p>
                        }
                        @await Html.PartialAsync("~/Views/Home/_SmartStockAnalysisList.cshtml",
                            new SmartStockAnalysisListViewModel(panel.Items, panel.Buying, panel.Empty))
                        <p class="smart-stock-live__empty" data-list-no-matches hidden>ไม่พบสินค้าตามตัวกรอง</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade smart-stock-live__modal" id="smartStockAnalysisDetail" tabindex="-1"
         aria-labelledby="smartStockAnalysisName" aria-hidden="true" data-smart-stock-detail-modal>
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header smart-stock-live__modal-header">
                    <div>
                        <div class="smart-stock-live__identity" data-detail="identity"></div>
                        <h2 class="modal-title fs-5" id="smartStockAnalysisName" data-detail="name"></h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
                </div>
                <div class="modal-body">
                    <div class="smart-stock-live__decision">
                        <div>
                            <span class="smart-stock-risk" data-detail="risk"></span>
                            <h3 data-detail="action"></h3>
                            <p data-detail="reason"></p>
                        </div>
                        <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>
                    </div>
                    <dl class="smart-stock-live__facts">
                        <div><dt>@(Model.StockAsOf is DateOnly stockDate ? $"สต็อก ณ {stockDate:dd/MM/yyyy}" : "สต็อกปัจจุบัน")</dt><dd data-detail="stock"></dd></div>
                        <div>
                            <dt>จำนวนที่คาดว่าจะขายได้</dt><dd data-detail="demand"></dd>
                            <small>คำนวณจากยอดคาดการณ์ของกลุ่มตามสัดส่วนยอดขายของสินค้านี้</small>
                        </div>
                        <div>
                            <dt>เป้าสต็อกสำรอง</dt><dd data-detail="safety"></dd>
                            <small>จำนวนที่ต้องการให้เหลือเผื่อยอดขายสูงกว่าคาด</small>
                        </div>
                        <div>
                            <dt>คาดว่าจะเหลือหากไม่สั่งเพิ่ม</dt><dd data-detail="remaining"></dd>
                            <small>สต็อกหักยอดขายที่คาด ค่าติดลบคือจำนวนที่ขาด</small>
                        </div>
                    </dl>
                    <section class="smart-stock-live__order-breakdown" data-order-breakdown hidden
                             aria-labelledby="smartStockOrderBreakdownTitle">
                        <h3 id="smartStockOrderBreakdownTitle">ที่มาของจำนวนแนะนำสั่งเพิ่ม</h3>
                        <dl class="mb-0">
                            <div><dt>ชดเชยยอดสต็อกติดลบ</dt><dd data-detail="stockShortfall"></dd></div>
                            <div><dt>รองรับยอดขายส่วนที่สต็อกยังไม่พอ</dt><dd data-detail="uncoveredDemand"></dd></div>
                            <div><dt>เติมให้ถึงเป้าสต็อกสำรอง</dt><dd data-detail="safetyTopUp"></dd></div>
                            <div class="smart-stock-live__order-total"><dt>รวมแนะนำสั่งเพิ่ม</dt><dd data-detail="orderTotal"></dd></div>
                        </dl>
                        <p class="smart-stock-live__stock-check mb-0" data-stock-check hidden>
                            ยอดสต็อกในระบบติดลบ ควรตรวจนับและกระทบยอดก่อนสั่งซื้อ
                        </p>
                    </section>
                    <p class="smart-stock-live__method mb-0">
                        สัปดาห์ @weekText · โมเดล <strong data-detail="model"></strong> ·
                        SKU นี้คิดเป็น <strong data-detail="share"></strong> ของยอดขายกลุ่มในช่วง 12 สัปดาห์
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary me-auto" data-smart-stock-back hidden>
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>กลับรายการ
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" data-smart-stock-series>@Html.Raw(JsonSerializer.Serialize(Model.WeeklySales, jsonOptions))</script>
    <script type="application/json" data-smart-stock-analyses>@Html.Raw(JsonSerializer.Serialize(Model.Analyses, jsonOptions))</script>
</section>
