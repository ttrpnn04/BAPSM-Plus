@{
    var notifications = new List<(string Type, string Message)>();
    foreach (var (key, type) in new[]
    {
        ("Success", "success"),
        ("Error", "error"),
        ("Warning", "warning"),
        ("Info", "info")
    })
    {
        if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
        {
            notifications.Add((type, message));
        }
    }

    var modelErrors = ViewData.ModelState.Values
        .SelectMany(entry => entry.Errors)
        .Select(entry => entry.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
    if (modelErrors.Count > 0)
    {
        notifications.Add(("error", string.Join(" ", modelErrors)));
    }
}

@foreach (var notification in notifications)
{
    <div hidden data-bap-notification data-type="@notification.Type" data-message="@notification.Message"></div>
}
