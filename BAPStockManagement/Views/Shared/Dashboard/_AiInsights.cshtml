@model BAPStockManagement.ViewModels.Dashboard.DashboardPageViewModel
<section class="dashboard-card dashboard-widget dashboard-ai-card" aria-labelledby="ai-title">
    <header class="dashboard-card-header">
        <div>
            <h2 id="ai-title">AI Insight วันนี้</h2>
            <p>คำแนะนำจากผู้ช่วย AI</p>
        </div>
        <span class="ai-badge">AI</span>
    </header>
    @if (Model.Summary.AiInsights is { } insights)
    {
        <div class="ai-summary">
            <strong>สรุปให้คุณ</strong>
            <ul>
                @foreach (var highlight in insights.Highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        </div>
        <blockquote class="ai-quote">
            <span class="ai-quote-avatar" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                    <path d="M24 7c-8 0-14 6-14 15v9c0 7 6 11 14 11s14-4 14-11v-9c0-9-6-15-14-15Z" />
                    <path d="M17 21h.01M31 21h.01M19 30c3 3 7 3 10 0" />
                </svg>
            </span>
            <p>@insights.MascotQuote</p>
        </blockquote>
    }
    else
    {
        <div class="dashboard-empty-state">ยังไม่มีข้อมูลเชิงลึกในขณะนี้</div>
    }
    <button type="button" class="dashboard-text-link dashboard-ai-link">
        ดูรายงาน AI แบบละเอียด <span aria-hidden="true">→</span>
    </button>
</section>
