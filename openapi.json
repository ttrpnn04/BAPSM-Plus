{
  "openapi": "3.1.0",
  "info": {
    "title": "BAPStockManagement Dashboard API",
    "version": "1.0.0",
    "description": "Manual contract for the dashboard API. Responses use JSON camelCase, UTC timestamps, THB money objects, and UPPER_SNAKE_CASE enum strings."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "applicationCookie": []
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the signed-in user",
        "responses": {
          "200": {
            "description": "Current user and roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/notifications/unread-count": {
      "get": {
        "operationId": "getUnreadNotificationCount",
        "responses": {
          "200": {
            "description": "Unread notification count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadNotificationCountResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/products/search": {
      "get": {
        "operationId": "searchProducts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "$ref": "#/components/parameters/Limit10To50"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "operationId": "getDashboardSummary",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard summary",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummaryResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/forecast": {
      "get": {
        "operationId": "getDashboardForecast",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "name": "horizon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["3m", "6m", "12m"],
              "default": "6m"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast points for the requested horizon",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/stock-status": {
      "get": {
        "operationId": "getDashboardStockStatus",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Stock status categories",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockStatusResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/urgent-items": {
      "get": {
        "operationId": "getDashboardUrgentItems",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "$ref": "#/components/parameters/Limit1To50Default4"
          }
        ],
        "responses": {
          "200": {
            "description": "Urgent stock items",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UrgentItemsResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/top-products": {
      "get": {
        "operationId": "getDashboardTopProducts",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["30d"],
              "default": "30d"
            }
          },
          {
            "$ref": "#/components/parameters/Limit1To50Default5"
          }
        ],
        "responses": {
          "200": {
            "description": "Most-used products",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopProductsResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/dashboard/ai-insights": {
      "get": {
        "operationId": "getDashboardAiInsights",
        "description": "Client-cacheable for 30 seconds; supports If-None-Match and ETag.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "AI dashboard insights; data may be null when unavailable",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiInsightsResponse"
                }
              }
            }
          },
          "304": {
            "description": "The cached representation is still current"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/simulations/what-if": {
      "post": {
        "operationId": "simulateWhatIf",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestVerificationToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfSimulationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatIfSimulationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/purchase-requests/auto-generate": {
      "post": {
        "operationId": "autoGeneratePurchaseRequests",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestVerificationToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AutoGeneratePurchaseRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL of the job resource"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseRequestJobResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/purchase-requests/jobs/{jobId}": {
      "get": {
        "operationId": "getPurchaseRequestJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseRequestJobResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/ai/chat": {
      "post": {
        "operationId": "postAiChat",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestVerificationToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stub chat response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiChatResponseEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "applicationCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": ".AspNetCore.Identity.Application"
      }
    },
    "parameters": {
      "Limit10To50": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      },
      "Limit1To50Default4": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 4
        }
      },
      "Limit1To50Default5": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5
        }
      },
      "RequestVerificationToken": {
        "name": "RequestVerificationToken",
        "in": "header",
        "required": true,
        "description": "ASP.NET Core antiforgery request token emitted by the dashboard page.",
        "schema": {
          "type": "string"
        }
      },
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Conditional request entity tag."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{8,128}$"
        }
      }
    },
    "headers": {
      "ETag": {
        "schema": {
          "type": "string"
        },
        "description": "Strong entity tag for conditional GET requests."
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC 7807 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiMeta": {
        "type": "object",
        "required": ["requestId", "generatedAt"],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp."
          }
        }
      },
      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string",
            "enum": ["THB"]
          }
        }
      },
      "Me": {
        "type": "object",
        "required": ["userId", "roles"],
        "properties": {
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": ["string", "null"]
          },
          "email": {
            "type": ["string", "null"],
            "format": "email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UnreadNotificationCount": {
        "type": "object",
        "required": ["count"],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProductSearchResult": {
        "type": "object",
        "required": ["sku", "productName", "onHand", "unit"],
        "properties": {
          "sku": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "onHand": {
            "type": "integer"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "DashboardKpis": {
        "type": "object",
        "required": [
          "totalProducts",
          "inventoryValue",
          "lowStockProducts",
          "recommendedReorders",
          "productCountChangePercent",
          "inventoryValueChangePercent",
          "lowStockChange"
        ],
        "properties": {
          "totalProducts": {
            "type": "integer"
          },
          "inventoryValue": {
            "$ref": "#/components/schemas/Money"
          },
          "lowStockProducts": {
            "type": "integer"
          },
          "recommendedReorders": {
            "type": "integer"
          },
          "productCountChangePercent": {
            "type": "integer"
          },
          "inventoryValueChangePercent": {
            "type": "integer"
          },
          "lowStockChange": {
            "type": "integer"
          }
        }
      },
      "ForecastPoint": {
        "type": "object",
        "required": ["month", "actual", "forecast", "confidenceLow", "confidenceHigh"],
        "properties": {
          "month": {
            "type": "string",
            "description": "Localized month label for display."
          },
          "actual": {
            "type": ["number", "null"]
          },
          "forecast": {
            "type": ["number", "null"]
          },
          "confidenceLow": {
            "type": ["number", "null"]
          },
          "confidenceHigh": {
            "type": ["number", "null"]
          }
        }
      },
      "DashboardForecast": {
        "type": "object",
        "required": ["horizon", "points"],
        "properties": {
          "horizon": {
            "type": "string",
            "enum": ["3m", "6m", "12m"]
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            }
          }
        }
      },
      "StockStatus": {
        "type": "object",
        "required": ["status", "percentage", "count"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["NORMAL", "LOW_STOCK", "OUT_OF_STOCK", "OVERSTOCK"]
          },
          "percentage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UrgentItem": {
        "type": "object",
        "required": [
          "sku",
          "productName",
          "daysUntilStockout",
          "onHand",
          "recommendedOrderQuantity"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "daysUntilStockout": {
            "type": "integer"
          },
          "onHand": {
            "type": "integer"
          },
          "recommendedOrderQuantity": {
            "type": "integer"
          }
        }
      },
      "AiInsights": {
        "type": "object",
        "required": ["summary", "highlights", "mascotQuote"],
        "properties": {
          "summary": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mascotQuote": {
            "type": "string"
          }
        }
      },
      "TopProduct": {
        "type": "object",
        "required": ["productName", "usage30Days", "changePercent", "trend"],
        "properties": {
          "productName": {
            "type": "string"
          },
          "usage30Days": {
            "type": "integer"
          },
          "changePercent": {
            "type": "integer"
          },
          "trend": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "WhatIfSimulation": {
        "type": "object",
        "required": [
          "sku",
          "productName",
          "minimumOrderQuantity",
          "maximumOrderQuantity",
          "orderQuantityStep",
          "quantityTicks",
          "orderQuantity",
          "stockoutRiskPercent",
          "orderCost",
          "holdingCost",
          "coverageDays"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "minimumOrderQuantity": {
            "type": "integer"
          },
          "maximumOrderQuantity": {
            "type": "integer"
          },
          "orderQuantityStep": {
            "type": "integer"
          },
          "quantityTicks": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "orderQuantity": {
            "type": "integer"
          },
          "stockoutRiskPercent": {
            "type": "number"
          },
          "orderCost": {
            "$ref": "#/components/schemas/Money"
          },
          "holdingCost": {
            "$ref": "#/components/schemas/Money"
          },
          "coverageDays": {
            "type": "integer"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "required": [
          "kpis",
          "unreadNotificationCount",
          "forecast",
          "stockStatus",
          "urgentItems",
          "aiInsights",
          "topProducts",
          "whatIf"
        ],
        "properties": {
          "kpis": {
            "$ref": "#/components/schemas/DashboardKpis"
          },
          "unreadNotificationCount": {
            "type": "integer"
          },
          "forecast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            }
          },
          "stockStatus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockStatus"
            }
          },
          "urgentItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrgentItem"
            }
          },
          "aiInsights": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AiInsights"
              },
              {
                "type": "null"
              }
            ]
          },
          "topProducts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopProduct"
            }
          },
          "whatIf": {
            "$ref": "#/components/schemas/WhatIfSimulation"
          }
        }
      },
      "WhatIfSimulationRequest": {
        "type": "object",
        "required": ["sku", "orderQty"],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "orderQty": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000,
            "multipleOf": 100
          }
        }
      },
      "AutoGeneratePurchaseRequest": {
        "type": "object",
        "required": ["strategy"],
        "properties": {
          "strategy": {
            "type": "string",
            "enum": ["AI_RECOMMENDED"]
          },
          "skus": {
            "type": ["array", "null"],
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      },
      "PurchaseRequestJobStatus": {
        "type": "string",
        "enum": ["QUEUED", "COMPLETED", "FAILED"]
      },
