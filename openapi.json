            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "message": {
            "type": ["string", "null"]
          }
        }
      },
      "AiChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "conversationId": {
            "type": ["string", "null"],
            "maxLength": 100
          }
        }
      },
